<Window x:Class="TacomaDiag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TacomaDiag" Height="780" Width="1160" MinHeight="650" MinWidth="980"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101418"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171D23"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#202832"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2B3540"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#3B4652"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EDF2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB6C2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2BB3A3"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#36C7B6"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#06110F"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Margin="0,0,24,0">
                    <TextBlock Text="TacomaDiag" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProfileTextBlock" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="AdapterModeComboBox" Width="190" SelectionChanged="AdapterModeComboBox_SelectionChanged"/>
                    <Button x:Name="RefreshPortsButton" Content="Refresh" Click="RefreshPortsButton_Click"/>
                    <ComboBox x:Name="PortComboBox" Width="115"/>
                    <ComboBox x:Name="BaudComboBox" Width="105"/>
                    <ComboBox x:Name="ProtocolComboBox" Width="135"/>
                    <ComboBox x:Name="J2534DllComboBox" Width="230"/>
                    <Button x:Name="BrowseJ2534Button" Content="Browse DLL" Click="BrowseJ2534Button_Click"/>
                    <Button x:Name="AdapterSelfTestButton" Content="Self Test" Click="AdapterSelfTestButton_Click"/>
                    <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"/>
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click"/>
                </WrapPanel>

                <TextBlock x:Name="ConnectionStatusTextBlock" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="14">
            <TabItem Header="Codes">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Full Scan" Click="FullScanButton_Click"/>
                        <Button Content="Stored" Click="StoredCodesButton_Click"/>
                        <Button Content="Pending" Click="PendingCodesButton_Click"/>
                        <Button Content="Permanent" Click="PermanentCodesButton_Click"/>
                        <Button Content="Freeze Frame" Click="FreezeFrameButton_Click"/>
                        <Button Content="Clear Codes" Background="{StaticResource DangerBrush}" Foreground="White" Click="ClearCodesButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="DtcDataGrid" Grid.Row="1" ItemsSource="{Binding DtcRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="CodesLogTextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Workflows">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="WorkflowComboBox" Width="260"/>
                        <Button Content="Load Workflow" Click="LoadWorkflowButton_Click"/>
                        <Button Content="Copy To Report" Click="CopyWorkflowToReportButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="WorkflowTextBox" Grid.Row="1" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Advisor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh Advisor" Click="RefreshAdvisorButton_Click"/>
                        <Button Content="Save Session" Click="SaveSessionButton_Click"/>
                        <Button Content="Open History Folder" Click="OpenHistoryFolderButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="HealthFindingsDataGrid" Grid.Row="1" ItemsSource="{Binding HealthFindingRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="130"/>
                            <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="*"/>
                            <DataGridTextColumn Header="Next Step" Binding="{Binding NextStep}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="ReadinessGuideTextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Freeze Frame">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Read Freeze Frame" Click="FreezeFrameButton_Click"/>
                        <Button Content="Copy To Report" Click="RefreshReportButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="FreezeFrameDataGrid" Grid.Row="1" ItemsSource="{Binding FreezeFrameRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="FreezeFrameLogTextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Readiness">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check Readiness" Click="ReadinessButton_Click"/>
                        <Button Content="Read VIN" Click="VinButton_Click"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
                        <TextBlock x:Name="MilTextBlock" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DtcCountTextBlock" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EngineTypeTextBlock" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VinTextBlock" FontSize="16" FontWeight="SemiBold"/>
                    </UniformGrid>

                    <DataGrid x:Name="ReadinessDataGrid" Grid.Row="2" ItemsSource="{Binding MonitorRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Monitor" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Supported" Binding="{Binding Supported}" Width="120"/>
                            <DataGridTextColumn Header="Ready" Binding="{Binding Ready}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Live Data">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Load Support" Click="LoadSupportedPidsButton_Click"/>
                        <Button Content="Read Once" Click="ReadLiveOnceButton_Click"/>
                        <Button Content="Start Polling" Click="StartPollingButton_Click"/>
                        <Button Content="Stop" Click="StopPollingButton_Click"/>
                        <Button Content="Start Recording" Click="StartRecordingButton_Click"/>
                        <Button Content="Stop Recording" Click="StopRecordingButton_Click"/>
                        <Button Content="Export CSV" Click="ExportRecordingButton_Click"/>
                        <TextBlock Text="Interval ms" VerticalAlignment="Center" Margin="6,0,6,0"/>
                        <TextBox x:Name="PollIntervalTextBox" Text="1000" Width="80"/>
                        <TextBlock x:Name="LiveRecordingStatusTextBlock" Text="Recording: off" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="LiveDataGrid" Grid.Row="1" ItemsSource="{Binding LivePidRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Supported" Binding="{Binding Supported}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="LiveDashboardTextBox" Grid.Row="2" Margin="0,10,0,0"
                             Height="76" FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Mode 6 / Modules">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Read Mode 6" Click="Mode6Button_Click"/>
                        <Button Content="Probe Modules" Click="ProbeModulesButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="Mode6DataGrid" Grid.Row="1" ItemsSource="{Binding Mode6Rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Test ID" Binding="{Binding TestId}" Width="*"/>
                            <DataGridTextColumn Header="CID" Binding="{Binding ComponentId}" Width="80"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="110"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding Minimum}" Width="110"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding Maximum}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="Mode6TextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Raw Terminal">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="RawCommandTextBox" Width="220" Text="0100"/>
                        <Button Content="Send" Click="RawSendButton_Click"/>
                        <Button Content="Adapter Self Test" Click="AdapterSelfTestButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="TerminalTextBox" Grid.Row="1" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh History" Click="RefreshHistoryButton_Click"/>
                        <Button Content="Save Current Session" Click="SaveSessionButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="HistoryDataGrid" Grid.Row="1" ItemsSource="{Binding SessionRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="150"/>
                            <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleName}" Width="180"/>
                            <DataGridTextColumn Header="VIN" Binding="{Binding Vin}" Width="170"/>
                            <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="170"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="170"/>
                            <DataGridTextColumn Header="Codes" Binding="{Binding StoredCodeCount}" Width="70"/>
                            <DataGridTextColumn Header="Not Ready" Binding="{Binding NotReadyMonitorCount}" Width="90"/>
                            <DataGridTextColumn Header="Summary" Binding="{Binding HealthSummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Report">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh Report" Click="RefreshReportButton_Click"/>
                        <Button Content="Save Report" Click="SaveReportButton_Click"/>
                        <Button Content="Save HTML Report" Click="SaveHtmlReportButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="ReportTextBox" Grid.Row="1" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="FooterStatusTextBlock" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
