<Window x:Class="TacomaDiag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OBD2 Master, Custom" Icon="Assets/AppIcon.ico"
        Height="780" Width="1160" MinHeight="650" MinWidth="980"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#050A10"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0B121B"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#101C29"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#162638"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#244156"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F7FB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A8BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#049DFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2DB7FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C62839"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#03111B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="76" Height="76" CornerRadius="10" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" ClipToBounds="True" Background="#02070C">
                    <Image Source="Assets/AppLogo.png" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="16,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="OBD2 Master, Custom" Foreground="{StaticResource TextPrimaryBrush}" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Diagnostics. Data. Control." Foreground="{StaticResource AccentHoverBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,9"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="VehicleProfileComboBox" Width="280" Margin="0,0,10,0" SelectionChanged="VehicleProfileComboBox_SelectionChanged"/>
                        <TextBlock x:Name="ProfileTextBlock" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="ConnectionStatusTextBlock" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" MaxWidth="720">
                        <ComboBox x:Name="AdapterModeComboBox" Width="190" SelectionChanged="AdapterModeComboBox_SelectionChanged"/>
                        <Button x:Name="RefreshPortsButton" Content="Refresh" Click="RefreshPortsButton_Click"/>
                        <ComboBox x:Name="PortComboBox" Width="115"/>
                        <ComboBox x:Name="BaudComboBox" Width="105"/>
                        <ComboBox x:Name="ProtocolComboBox" Width="135"/>
                        <ComboBox x:Name="J2534DllComboBox" Width="230"/>
                        <Button x:Name="BrowseJ2534Button" Content="Browse DLL" Click="BrowseJ2534Button_Click"/>
                        <Button x:Name="AdapterSelfTestButton" Content="Self Test" Click="AdapterSelfTestButton_Click"/>
                        <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="14">
            <TabItem Header="Codes">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Full Scan" Click="FullScanButton_Click"/>
                        <Button Content="Stored" Click="StoredCodesButton_Click"/>
                        <Button Content="Pending" Click="PendingCodesButton_Click"/>
                        <Button Content="Permanent" Click="PermanentCodesButton_Click"/>
                        <Button Content="Freeze Frame" Click="FreezeFrameButton_Click"/>
                        <Button Content="Clear Codes" Background="{StaticResource DangerBrush}" Foreground="White" Click="ClearCodesButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="DtcDataGrid" Grid.Row="1" ItemsSource="{Binding DtcRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="CodesLogTextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Workflows">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="WorkflowComboBox" Width="260"/>
                        <Button Content="Load Workflow" Click="LoadWorkflowButton_Click"/>
                        <Button Content="Copy To Report" Click="CopyWorkflowToReportButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="WorkflowTextBox" Grid.Row="1" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Advisor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh Advisor" Click="RefreshAdvisorButton_Click"/>
                        <Button Content="Save Session" Click="SaveSessionButton_Click"/>
                        <Button Content="Open History Folder" Click="OpenHistoryFolderButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="HealthFindingsDataGrid" Grid.Row="1" ItemsSource="{Binding HealthFindingRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="130"/>
                            <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="*"/>
                            <DataGridTextColumn Header="Next Step" Binding="{Binding NextStep}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="ReadinessGuideTextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Freeze Frame">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Read Freeze Frame" Click="FreezeFrameButton_Click"/>
                        <Button Content="Copy To Report" Click="RefreshReportButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="FreezeFrameDataGrid" Grid.Row="1" ItemsSource="{Binding FreezeFrameRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="FreezeFrameLogTextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Readiness">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check Readiness" Click="ReadinessButton_Click"/>
                        <Button Content="Read VIN" Click="VinButton_Click"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
                        <TextBlock x:Name="MilTextBlock" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DtcCountTextBlock" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EngineTypeTextBlock" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VinTextBlock" FontSize="16" FontWeight="SemiBold"/>
                    </UniformGrid>

                    <DataGrid x:Name="ReadinessDataGrid" Grid.Row="2" ItemsSource="{Binding MonitorRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Monitor" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Supported" Binding="{Binding Supported}" Width="120"/>
                            <DataGridTextColumn Header="Ready" Binding="{Binding Ready}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Live Data">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Load Support" Click="LoadSupportedPidsButton_Click"/>
                        <Button Content="Read Once" Click="ReadLiveOnceButton_Click"/>
                        <Button Content="Start Polling" Click="StartPollingButton_Click"/>
                        <Button Content="Stop" Click="StopPollingButton_Click"/>
                        <Button Content="Start Recording" Click="StartRecordingButton_Click"/>
                        <Button Content="Stop Recording" Click="StopRecordingButton_Click"/>
                        <Button Content="Export CSV" Click="ExportRecordingButton_Click"/>
                        <TextBlock Text="Interval ms" VerticalAlignment="Center" Margin="6,0,6,0"/>
                        <TextBox x:Name="PollIntervalTextBox" Text="1000" Width="80"/>
                        <TextBlock x:Name="LiveRecordingStatusTextBlock" Text="Recording: off" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="LiveDataGrid" Grid.Row="1" ItemsSource="{Binding LivePidRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Supported" Binding="{Binding Supported}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox x:Name="LiveDashboardTextBox" Grid.Row="2" Margin="0,10,0,0"
                             Height="76" FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Mode 6 / Modules">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Read Mode 6" Click="Mode6Button_Click"/>
                        <Button Content="Probe Modules" Click="ProbeModulesButton_Click"/>
                        <Button Content="Enhanced Module Scan" Click="EnhancedModuleScanButton_Click"/>
                        <Button Content="Transmission Scan" Click="TransmissionModuleScanButton_Click"/>
                    </StackPanel>

                    <TabControl Grid.Row="1" Margin="0,10,0,0">
                        <TabItem Header="Mode 6">
                            <DataGrid x:Name="Mode6DataGrid" ItemsSource="{Binding Mode6Rows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Test ID" Binding="{Binding TestId}" Width="*"/>
                                    <DataGridTextColumn Header="CID" Binding="{Binding ComponentId}" Width="80"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="110"/>
                                    <DataGridTextColumn Header="Min" Binding="{Binding Minimum}" Width="110"/>
                                    <DataGridTextColumn Header="Max" Binding="{Binding Maximum}" Width="110"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Module Scan">
                            <DataGrid x:Name="ModuleScanDataGrid" ItemsSource="{Binding ModuleScanRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="170"/>
                                    <DataGridTextColumn Header="System" Binding="{Binding System}" Width="110"/>
                                    <DataGridTextColumn Header="Header" Binding="{Binding RequestHeader}" Width="80"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                    <DataGridTextColumn Header="DTCs" Binding="{Binding DtcSummary}" Width="*"/>
                                    <DataGridTextColumn Header="ECU ID" Binding="{Binding EcuId}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>

                    <TextBox x:Name="Mode6TextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="MPPS V16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Scan MPPS" Click="ScanMppsButton_Click"/>
                        <ComboBox x:Name="MppsToolComboBox" Width="330" SelectionChanged="MppsToolComboBox_SelectionChanged"/>
                        <Button Content="Browse EXE" Click="BrowseMppsButton_Click"/>
                        <Button Content="Launch MPPS" Click="LaunchMppsButton_Click"/>
                        <Button Content="Add To Report" Click="AddMppsToReportButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="MppsPathTextBox" Grid.Row="1" Margin="0,10,0,0"
                             IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"/>

                    <TextBox x:Name="MppsNotesTextBox" Grid.Row="2" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Raw Terminal">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="RawCommandTextBox" Width="220" Text="0100"/>
                        <Button Content="Send" Click="RawSendButton_Click"/>
                        <Button Content="Adapter Self Test" Click="AdapterSelfTestButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="TerminalTextBox" Grid.Row="1" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh History" Click="RefreshHistoryButton_Click"/>
                        <Button Content="Save Current Session" Click="SaveSessionButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="HistoryDataGrid" Grid.Row="1" ItemsSource="{Binding SessionRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="150"/>
                            <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleName}" Width="180"/>
                            <DataGridTextColumn Header="VIN" Binding="{Binding Vin}" Width="170"/>
                            <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="170"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="170"/>
                            <DataGridTextColumn Header="Codes" Binding="{Binding StoredCodeCount}" Width="70"/>
                            <DataGridTextColumn Header="Not Ready" Binding="{Binding NotReadyMonitorCount}" Width="90"/>
                            <DataGridTextColumn Header="Summary" Binding="{Binding HealthSummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Report">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh Report" Click="RefreshReportButton_Click"/>
                        <Button Content="Save Report" Click="SaveReportButton_Click"/>
                        <Button Content="Save HTML Report" Click="SaveHtmlReportButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="ReportTextBox" Grid.Row="1" Margin="0,10,0,0"
                             FontFamily="Consolas" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="FooterStatusTextBlock" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
